# Copy this file to .env.local and adjust values for local development.
# Vite exposes only variables prefixed with VITE_ to browser code.

# Backend origin, without a trailing slash and without /api.
# Leave empty when the built frontend is served from the same origin as FastAPI.
VITE_API_BASE_URL=http://localhost:8000

# WebSocket origin, without a trailing slash and without /ws.
# Use wss:// in production. Leave empty to derive it from VITE_API_BASE_URL.
VITE_WS_BASE_URL=ws://localhost:8000
