# Copy this file to .env and adjust values. Never commit .env.

# development | test | production
ENVIRONMENT=development

# Enable verbose framework output. Must be false in production.
DEBUG=false

# Secret used to hash session tokens (HMAC-SHA256).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# A value of at least 32 characters is required in production.
SECRET_KEY=replace-with-a-long-random-secret

# SQLite database location, relative to the backend working directory.
DATABASE_URL=sqlite:///./data/guess_the_character.db

# JSON array of allowed browser origins. Use [] when FastAPI serves the built
# frontend on the same origin; keep the Vite origins for separate dev servers.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Lifetime of a player session token.
SESSION_TOKEN_TTL_HOURS=24

# Lifetime of the reconnect credential used to restore an expired session.
# Must be greater than or equal to SESSION_TOKEN_TTL_HOURS.
RECONNECT_TOKEN_TTL_HOURS=168

# Directory for validated, re-encoded character images.
MEDIA_ROOT=./storage

# Public URL prefix that maps to MEDIA_ROOT. Must start with "/" and must not
# end with "/".
MEDIA_URL_PREFIX=/media

# Directory containing the built React app (index.html + assets). When set,
# FastAPI serves the SPA on the same origin as the API, media, and WebSockets.
# Leave empty for API-only mode or when using the Vite dev server.
# FRONTEND_DIST_DIR=../frontend/dist

# Maximum accepted character image size in bytes (1 KiB–5 MiB).
IMAGE_MAX_BYTES=5242880

# Timeout in seconds for downloading an external character image URL.
IMAGE_DOWNLOAD_TIMEOUT_SECONDS=5
